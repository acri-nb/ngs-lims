# Internal-network deployment: plain HTTP, no TLS. server_name is the
# server's internal IP (or hostname if you have internal DNS) — no public
# domain needed. Keep this server off any interface reachable from outside
# the company network (see documentation/PRODUCTION.md).

server {
    listen 80;
    server_name __SERVER_ADDR__;

    client_max_body_size 25M;   # allow CSV / plate-import uploads through

    location /static/ {
        alias __DEPLOY_PATH__/staticfiles/;
    }

    location /media/ {
        alias __DEPLOY_PATH__/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:10000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
